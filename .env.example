# Copy to .env and supply your own secrets, or run: python3 scripts/init_env.py
APP_ENV=development
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=academicflow
DATABASE_PORT=5432
JWT_SECRET=
TOKEN_MINUTES=60
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# openai = real extraction/embeddings; demo = explicitly labeled offline lexical provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Configurable MVP defaults, fractions (NOT percentages)
AUTO_LINK_THRESHOLD=0.90
HUMAN_REVIEW_THRESHOLD=0.50
MAX_UPLOAD_BYTES=5242880

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
# n8n in Docker reaches a backend on the host. For host-native n8n use http://localhost:8000.
FASTAPI_BASE_URL=http://host.docker.internal:8000

# Reserved for future S3 adapter; not consumed by local filesystem storage.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
